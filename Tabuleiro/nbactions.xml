<?xml version="1.0" encoding="UTF-8"?>
<actions>
        <action>
            <actionName>run</actionName>
            <packagings>
                <packaging>jar</packaging>
            </packagings>
            <goals>
                <goal>process-classes</goal>
                <goal>org.openjfx:javafx-maven-plugin:0.0.8:run</goal>
            </goals>
            <properties>
                <javafx.mainClass>${exec.mainClass}</javafx.mainClass>
            </properties>
        </action>
        <action>
            <actionName>debug</actionName>
            <packagings>
                <packaging>jar</packaging>
            </packagings>
            <goals>
                <goal>process-classes</goal>
                <goal>org.openjfx:javafx-maven-plugin:0.0.8:run</goal>
            </goals>
            <properties>
                <javafx.mainClass>${exec.mainClass}</javafx.mainClass>
                <javafx.jvmArgs>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</javafx.jvmArgs>
                <jpda.listen>true</jpda.listen>
            </properties>
        </action>
        <action>
            <actionName>profile</actionName>
            <packagings>
                <packaging>jar</packaging>
            </packagings>
            <goals>
                <goal>process-classes</goal>
                <goal>org.openjfx:javafx-maven-plugin:0.0.8:run</goal>
            </goals>
            <properties>
                <javafx.mainClass>${exec.mainClass}</javafx.mainClass>
            </properties>
        </action>
    </actions>